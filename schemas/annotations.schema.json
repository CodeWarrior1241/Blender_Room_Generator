{
  "$defs": {
    "BoundaryLine": {
      "additionalProperties": false,
      "description": "A traced stretch of a room boundary: wall/floor, wall/ceiling, or a vertical wall/wall corner.\n\nUse when a corner's foot is hidden but the boundary itself is visible.",
      "properties": {
        "kind": {
          "enum": [
            "wall_floor",
            "wall_ceiling",
            "wall_wall"
          ],
          "title": "Kind",
          "type": "string"
        },
        "pixels": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 2,
          "title": "Pixels",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "kind",
        "pixels"
      ],
      "title": "BoundaryLine",
      "type": "object"
    },
